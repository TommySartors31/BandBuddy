rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isTeacherOrDev() {
      return isSignedIn() && (myRole() == 'teacher' || myRole() == 'dev');
    }
    function isDev() {
      return isSignedIn() && myRole() == 'dev';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------------- users ----------------
    match /users/{uid} {
      allow read: if isSignedIn();
      // Anyone can create their OWN doc at sign-up (role is set client-side once,
      // matched against DEV_EMAIL/TEACHER_EMAIL — see note below for hardening).
      allow create: if isOwner(uid);
      // Students may only ever touch a safe allow-list of their own fields —
      // never role, currentRP, currentSeasonXP, streak, seasonPassLevel.
      allow update: if isTeacherOrDev() ||
        (isOwner(uid) &&
         !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'currentRP', 'currentSeasonXP', 'streak',
                     'lastStreakDate', 'seasonPassLevel']));
      allow delete: if isDev();
    }

    // ---------------- seasons ----------------
    match /seasons/{id} {
      allow read: if isSignedIn();
      allow write: if isDev();
    }

    // ---------------- season history (archive) ----------------
    match /seasonHistory/{id} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrDev();
    }

    // ---------------- performances ----------------
    match /performances/{id} {
      allow read: if isSignedIn();
      // A student may create their own performance, but never as already-graded,
      // and never with rpAwarded/xpAwarded/bmcsPts set by themselves.
      allow create: if isOwner(request.resource.data.uid) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.grade == null &&
        request.resource.data.rpAwarded == null;
      // Only teacher/dev can transition status -> graded and set scores.
      allow update: if isTeacherOrDev();
      allow delete: if isTeacherOrDev();
    }

    // ---------------- music library ----------------
    match /music/{id} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrDev();
    }

    // ---------------- tournaments ----------------
    match /tournaments/{id} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrDev();
    }

    // ---------------- assignments (music + due date) ----------------
    match /assignments/{id} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrDev();
    }

    // ---------------- qualifications (Major/Minor Qualifier tracking) ----------------
    match /qualifications/{id} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrDev();
    }

    // ---------------- guess the note results ----------------
    match /guessTheNoteResults/{uid} {
      allow read: if isSignedIn();
      // Students can write only their OWN results, and this never
      // touches RP anywhere in the schema.
      allow write: if isOwner(uid) || isTeacherOrDev();
    }

    // ---------------- config (RP table, season pass levels, tunables) ----------------
    match /config/{id} {
      allow read: if isSignedIn();
      allow write: if isDev();
    }

    // ---------------- announcements ----------------
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrDev();
    }

    // ---------------- audit log ----------------
    match /auditLog/{id} {
      allow read: if isDev();
      // Written by the app on the server-trusted actions above; anyone
      // signed in may create an entry (the app always sets `who` to the
      // caller's own uid) but nobody may edit or delete history.
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}

// ------------------------------------------------------------------
// IMPORTANT HARDENING NOTE FOR THE DEV ACCOUNT:
// This ruleset trusts users/{uid}.role as the source of truth, which is
// good enough for a school-scale, non-adversarial deployment. A student
// cannot grant themselves teacher/dev because updates to `role` are
// blocked unless the CALLER already has teacher/dev in their own doc.
// The one gap: at first sign-up, the client decides the role by matching
// the typed email against DEV_EMAIL/TEACHER_EMAIL in firebase-config.js.
// If you want this fully bulletproof against someone editing that JS
// file's compiled bundle, add a Cloud Function (Blaze plan, still free
// under normal school usage) that sets a custom auth claim for those two
// exact emails on account creation instead. For a school band app this
// current approach is a reasonable, zero-cost tradeoff.
// ------------------------------------------------------------------
